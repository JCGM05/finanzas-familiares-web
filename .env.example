# Copia este fichero a .env y rellena los valores. NO subas el .env real al repo.

# ---------- Base de datos ----------
# En producción (Docker) se usa Postgres. En desarrollo local, si omites
# DATABASE_URL, la app usa SQLite (backend/dev_data/finanzas.db) sin instalar nada.
DATABASE_URL=postgresql+psycopg2://finanzas:CAMBIA_ESTA_CONTRASENA@db:5432/finanzas

# Credenciales del contenedor de Postgres (docker-compose)
POSTGRES_DB=finanzas
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA

# ---------- Seguridad ----------
# Clave para firmar los JWT. OBLIGATORIO en producción. Genera una cadena larga
# y aleatoria, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-una-cadena-larga-y-aleatoria
# Duración del token de acceso en minutos (opcional; por defecto 720 = 12 h)
ACCESS_TOKEN_MINUTES=720

# ---------- CORS ----------
# Dominio del frontend detrás de NGINX Proxy Manager. En dev se usa localhost:5173.
CORS_ORIGINS=https://finanzas.tudominio.com
